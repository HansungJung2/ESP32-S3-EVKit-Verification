/*
 * Device Tree Overlay for ESP32-S3 DevKit
 * Configures GPIO and Board Peripherals
 */

/ {
    aliases {
        led0 = &led_status;
    };

    leds {
        compatible = "gpio-leds";
        led_status: led_0 {
            gpios = <&gpio0 48 GPIO_ACTIVE_HIGH>;
            label = "Status LED";
        };
    };
};
